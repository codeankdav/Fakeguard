{
  "$schema": "https://vercel.sh",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/fakeguard run build && pnpm --filter @workspace/api-server run build:vercel",
  "outputDirectory": "artifacts/fakeguard/dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "artifacts/api-server/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
